#!/bin/bash

set -euo pipefail

color_red=$'\033[38;2;224;108;117m'
color_green=$'\033[38;2;99;210;151m'
color_yellow=$'\033[38;2;229;192;123m'
color_blue=$'\033[38;2;86;182;194m'
color_white=$'\033[38;2;171;178;191m'
reset=$'\033[0m'

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  exit 0
fi

repo_root="$(git rev-parse --quiet --show-toplevel 2>/dev/null || true)"
if [[ -z "$repo_root" || "$repo_root" == "$HOME" ]]; then
  exit 0
fi

dirty=false
if [[ -n "$(git status -s --ignore-submodules=dirty 2>/dev/null)" ]]; then
  dirty=true
fi

staged=false
modified=false
untracked=false
ahead_behind=""

while IFS= read -r line; do
  if [[ "$line" == '## '* ]]; then
    if [[ "$line" == *'ahead '* && "$line" == *'behind '* ]]; then
      ahead_behind="⇕"
    elif [[ "$line" == *'ahead '* ]]; then
      ahead_behind="⇡"
    elif [[ "$line" == *'behind '* ]]; then
      ahead_behind="⇣"
    fi
    continue
  fi

  x="${line:0:1}"
  y="${line:1:1}"

  if [[ "$x$y" == '??' ]]; then
    untracked=true
    continue
  fi

  if [[ "$x" != ' ' ]]; then
    staged=true
  fi

  if [[ "$y" != ' ' ]]; then
    modified=true
  fi
done < <(git status --porcelain --branch --ignore-submodules=dirty 2>/dev/null || true)

last_commit="$(git log --pretty=format:'%at' -1 2>/dev/null || true)"
if [[ -n "$last_commit" ]]; then
  now="$(date +%s)"
  seconds_since_last_commit=$((now - last_commit))
  minutes=$((seconds_since_last_commit / 60))
  hours=$((seconds_since_last_commit / 3600))
  days=$((seconds_since_last_commit / 86400))
  sub_hours=$((hours % 24))
  sub_minutes=$((minutes % 60))

  if [[ "$dirty" == true ]]; then
    if (( minutes > 120 )); then
      age_color="$color_red"
    elif (( minutes > 60 )); then
      age_color="$color_yellow"
    else
      age_color="$color_green"
    fi
  else
    age_color="$color_blue"
  fi

  if (( hours > 24 )); then
    age="${days}d${sub_hours}h${sub_minutes}m"
  elif (( minutes > 60 )); then
    age="${hours}h${sub_minutes}m"
  else
    age="${minutes}m"
  fi
else
  age_color="$color_blue"
  age="new"
fi

status_flags=""
if [[ "$modified" == true ]]; then
  status_flags+="!"
fi
if [[ "$staged" == true ]]; then
  status_flags+="+"
fi
if [[ "$untracked" == true ]]; then
  status_flags+="?"
fi
status_flags+="$ahead_behind"

bracket_color="$color_white"
status_color="$color_red"

if [[ -n "$status_flags" ]]; then
  printf '%s[%s%s %s%s%s%s' \
    "$bracket_color" \
    "$status_color" \
    "$status_flags" \
    "$age_color" \
    "$age" \
    "$bracket_color" \
    "]$reset"
else
  printf '%s[%s%s%s]%s' \
    "$bracket_color" \
    "$age_color" \
    "$age" \
    "$bracket_color" \
    "$reset"
fi
