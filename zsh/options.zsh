# Misc options
setopt AUTO_CD # Treat a directory name as a cd command when no command matches.
setopt NO_BG_NICE # Do not lower the priority of background jobs automatically.
setopt NO_HUP # Do not send SIGHUP to running jobs when the shell exits.
setopt NO_LIST_BEEP # Do not beep when completion matches are ambiguous.
setopt NO_BEEP # Do not beep on line-editor errors.
setopt LOCAL_OPTIONS # Restore option settings when a function returns.
setopt LOCAL_TRAPS # Restore signal traps when a function returns.
setopt COMPLETE_IN_WORD # Complete at the cursor position within a word.
setopt IGNORE_EOF # Require exit or logout instead of exiting on Ctrl-D.
