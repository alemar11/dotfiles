[user]
	name = Alessandro Marzoli
	email = alessandromarzoli@gmail.com
[http]
  sslVerify = true
[core]
  editor = nvim
  excludesfile = ~/.gitignore_global
[merge]
  tool = nvimdiff
[push]
  default = upstream
[alias]
  a = add
  last = diff HEAD^ HEAD
  last-msg = !git --no-pager log --format=format:%B -1
  last-sha = !git --no-pager log --format=format:%H -1
  pul = pull
  sub = submodule update --init --recursive
  undo = reset --soft HEAD^
  wip = for-each-ref --sort='authordate:iso8601' --format=' %(color:green)%(authordate:relative)%09%(color:white)%(refname:short)' refs/heads
  tidy = "!f() { \
    git fetch --prune || return 1; \
    gone=$(git branch -vv | awk '/: gone]/{print $1}'); \
    [ -z \"$gone\" ] && { echo 'No gone branches.'; return 0; }; \
    echo \"$gone\" | xargs -n 1 git branch -d; \
  }; f"
[fetch]
  prune = true
[pull]
	ff = only
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = false
